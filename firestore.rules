rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    // User-owned application data.
    match /albuns/{albumId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if owns(resource.data) || isAdmin();
      allow update: if (owns(resource.data) || isAdmin())
        && request.resource.data.userId == resource.data.userId;
    }

    match /quadrinhos/{obraId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if owns(resource.data) || isAdmin();
      allow update: if (owns(resource.data) || isAdmin())
        && request.resource.data.userId == resource.data.userId;
    }

    match /viagens/{viagemId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if owns(resource.data) || isAdmin();
      allow update: if (owns(resource.data) || isAdmin())
        && request.resource.data.userId == resource.data.userId;
    }

    match /historico_reaudicoes/{reaudicaoId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if owns(resource.data) || isAdmin();
      allow update: if (owns(resource.data) || isAdmin())
        && request.resource.data.userId == resource.data.userId;
    }

    match /reaudicoes/{reaudicaoId} {
      allow read, delete: if owns(resource.data) || isAdmin();
      allow update: if (owns(resource.data) || isAdmin())
        && request.resource.data.userId == resource.data.userId;
    }

    match /usuarios/{userId} {
      allow create: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow read, update, delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}
